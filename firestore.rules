rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in
        get(/databases/$(database)/documents/config/roles).data.admins;
    }
    // Superuser (PIC PT): anggota yang field "role"-nya = 'superuser' (diatur Admin lewat Kelola akun di aplikasi)
    function isPic() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('role', 'user') == 'superuser';
    }
    function isMember() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email)));
    }
    // data sinkron: anggota membaca; Admin dan Superuser (PIC) boleh menulis (data CSV, tema, layer)
    match /sync/{doc} {
      allow read: if isMember();
      allow write: if isAdmin() || isPic();
    }
    // daftar Admin: diatur manual lewat konsol
    match /config/roles {
      allow read: if signedIn();
      allow write: if false;
    }
    // kategori catatan & alamat server foto: anggota membaca, hanya Admin yang menulis
    match /config/categories {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /config/app {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // catatan per blok: semua anggota membaca; penulis (atau Admin) mengubah; penulisnya tidak bisa dipalsukan
    match /notes/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.token.email;
      allow update: if isMember() && (isAdmin() || resource.data.by == request.auth.token.email)
                    && request.resource.data.by == resource.data.by;
      allow delete: if isAdmin();
    }
    // pengguna terdaftar: Admin mengelola dari aplikasi; tiap pengguna hanya bisa membaca dokumennya sendiri
    match /members/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if isAdmin();
    }
  }
}
